FROM node:22-bookworm-slim AS frontend-build

WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
ENV VITE_API_URL=/api
RUN npm run build

FROM node:22-bookworm-slim AS node-runtime

FROM cloudflare/cloudflared:latest AS cloudflared

FROM php:8.4-cli-bookworm

ENV DEBIAN_FRONTEND=noninteractive \
    APP_ENV=production \
    APP_DEBUG=false \
    DB_CONNECTION=pgsql \
    DB_HOST=127.0.0.1 \
    DB_PORT=5432 \
    DB_DATABASE=nusaerp \
    DB_USERNAME=nusaerp \
    POSTGRES_USER=postgres \
    POSTGRES_DB=nusaerp \
    PGDATA=/var/lib/nusaerp/postgres \
    N8N_PORT=5678 \
    N8N_HOST=0.0.0.0 \
    N8N_USER_FOLDER=/var/lib/nusaerp/n8n \
    NUSAERP_BACKEND_URL=http://127.0.0.1:8000 \
    N8N_PAYMENT_SUCCESS_WEBHOOK=http://127.0.0.1:5678/webhook/payment-success \
    N8N_PO_SUBMITTED_WEBHOOK=http://127.0.0.1:5678/webhook/po-submitted

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libpq-dev libzip-dev nginx postgresql postgresql-client supervisor unzip \
    && docker-php-ext-install pdo_pgsql pgsql zip \
    && useradd --system --uid 1000 --create-home --home-dir /var/lib/nusaerp/n8n --shell /usr/sbin/nologin node \
    && rm -rf /var/lib/apt/lists/*

COPY --from=node-runtime /usr/local/ /usr/local/
RUN npm install --global n8n
COPY --from=composer:2 /usr/bin/composer /usr/local/bin/composer
COPY --from=cloudflared /usr/local/bin/cloudflared /usr/local/bin/cloudflared

WORKDIR /opt/nusaerp/backend
COPY backend/composer.json backend/composer.lock ./
RUN composer install --no-dev --no-interaction --prefer-dist --no-progress --no-scripts --optimize-autoloader
COPY backend/ ./
COPY --from=frontend-build /build/frontend/dist /opt/nusaerp/frontend
COPY n8n/workflows /opt/nusaerp/workflows
COPY single-container/ /opt/nusaerp/container/

RUN rm -f bootstrap/cache/config.php bootstrap/cache/packages.php bootstrap/cache/services.php \
    && php artisan package:discover --ansi \
    && rm -f /etc/nginx/sites-enabled/default \
    && ln -s /opt/nusaerp/container/nginx.conf /etc/nginx/sites-enabled/nusaerp \
    && echo 'include /etc/supervisor/conf.d/*.conf' >> /etc/supervisor/supervisord.conf \
    && install -d -o postgres -g postgres /var/lib/nusaerp/postgres \
    && install -d -o node -g node /var/lib/nusaerp/n8n \
    && install -d /var/log/supervisor

EXPOSE 8080 5678
ENTRYPOINT ["/bin/bash", "/opt/nusaerp/container/entrypoint.sh"]