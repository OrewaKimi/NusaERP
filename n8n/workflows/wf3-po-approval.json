{
  "name": "WF3 PO Approval",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "po-submitted", "responseMode": "responseNode", "options": {} },
      "id": "webhook-po-submitted",
      "name": "PO Submitted Event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [180, 260],
      "webhookId": "nusaerp-po-submitted"
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict", "version": 2 },
          "conditions": [{ "leftValue": "={{$json.headers['x-automation-token']}}", "rightValue": "={{$env.NUSAERP_AUTOMATION_TOKEN}}", "operator": { "type": "string", "operation": "equals" } }],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "validate-po-event-token",
      "name": "Validate Event Token",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [400, 260]
    },
    {
      "parameters": {
        "assignments": { "assignments": [
          { "id": "event", "name": "event", "value": "purchase_order_submitted", "type": "string" },
          { "id": "purchase_order_id", "name": "purchase_order_id", "value": "={{$json.body.purchase_order_id}}", "type": "number" },
          { "id": "supplier", "name": "supplier", "value": "={{$json.body.supplier}}", "type": "string" },
          { "id": "total", "name": "total", "value": "={{$json.body.total}}", "type": "number" },
          { "id": "approval_url", "name": "approval_url", "value": "={{$env.FRONTEND_URL + '/purchases'}}", "type": "string" }
        ] },
        "options": {}
      },
      "id": "prepare-po-approval-request",
      "name": "Prepare Approval Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [640, 160]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{$json}}",
        "options": { "responseCode": 200 }
      },
      "id": "ack-po-submission",
      "name": "Acknowledge Approval Request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [900, 160]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={\"message\":\"Unauthorized\"}", "options": { "responseCode": 401 } },
      "id": "reject-po-event",
      "name": "Reject Invalid Token",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [640, 380]
    }
  ],
  "connections": {
    "PO Submitted Event": { "main": [[{ "node": "Validate Event Token", "type": "main", "index": 0 }]] },
    "Validate Event Token": { "main": [[{ "node": "Prepare Approval Request", "type": "main", "index": 0 }], [{ "node": "Reject Invalid Token", "type": "main", "index": 0 }]] },
    "Prepare Approval Request": { "main": [[{ "node": "Acknowledge Approval Request", "type": "main", "index": 0 }]] }
  },
  "pinData": {},
  "meta": {"instanceId": "nusaerp-lite"},
  "active": true,
  "versionId": "2"
}
